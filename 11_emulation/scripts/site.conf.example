# Copy to 11_emulation/site.conf (ignored by git) and set the paths on this host.
# Only locations live here; the scripts identify the media by the checks below.

# Intel: El Torito boot ISO made by the separate OPENSTEP_BOOTCD project
# (os42j_boot.iso, 545005568 bytes, sha256 1cb1bb8d5f5d5c02...ebec4).
OPENSTEP_BOOTCD_ISO=

# SPARC: an OPENSTEP 4.2 install CD image (os42j.iso or os42e.iso). Boots directly.
OS42_SPARC_ISO=

# m68k: the install CD image and the m68k startup floppy (4.2_Startup_Mach.img).
OS42_M68K_ISO=
OS42_M68K_BOOT_FLOPPY=

# All three: the OPENSTEP 4.2 developer CD (os42jdev.iso), for  vm-<arch>.sh boot --cd OS42_DEV_ISO
OS42_DEV_ISO=
