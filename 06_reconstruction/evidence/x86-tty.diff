+	if (cflag & CREAD)
+		pflags |= TP_CREAD;
+	if ((cflag & HUPCL) == 0)
+		flags |= NOHANG;
+	if (cflag & CLOCAL)
+		pflags |= TP_CLOCAL;
+	if (cflag & CSTOPB110)
+		pflags |= TP_CSTOPB110;
+	if (iflag & IGNBRK)
+		pflags |= TP_IGNBRK;
+	if (iflag & IGNPAR)
+		pflags |= TP_IGNPAR;
+	if (iflag & PARMRK)
+		pflags |= TP_PARMRK;
+	if (iflag & INPCK)
+		pflags |= TP_INPCK;
+	if (iflag & IXOFF)
+		flags |= TANDEM;
+	if ((iflag & IXANY) == 0)
+		flags |= DECCTQ;
