+	if (lflag & ECHOE)
+		flags |= CRTBS;
+	if (lflag & ECHOK)
+		pflags |= TP_ECHOK;
+	if (lflag & ECHOKE)
+		flags |= CRTKIL;
+	if (lflag & ECHOCRT)
+		flags |= CRTERA;
+	if (lflag & ECHOPRT)
+		flags |= PRTERA;
+	if (lflag & ECHOCTL)
+		flags |= CTLECH;
+	if (lflag & ECHONL)
