+
+void
+ns_callout_init()
+{
+	register unsigned int i;
+
+	ns_callfree = ns_callout;
+	for (i = 1; i < ncallout; i++)
+		ns_callout[i-1].c_next = &ns_callout[i];
+	ns_callout[ncallout-1].c_next = 0;
+}
