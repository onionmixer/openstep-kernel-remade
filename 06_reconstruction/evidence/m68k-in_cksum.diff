+	movl	a0@+,d2
+	addxl	d2,d0
+	movl	a0@+,d2
+	addxl	d2,d0
+	movl	a0@+,d2
+	addxl	d2,d0
+	movl	a0@+,d2
+	addxl	d2,d0
+	movl	a0@+,d2
+	addxl	d2,d0
+	movl	a0@+,d2
+	addxl	d2,d0
+	dbf	d1,3b
