+rtc_tick()	/* plan 535 (D024): new in the 1997 kernel, from the original bytes 0x40912be */
+{
+	int addr, val;
+
+	addr = (rtc_read (RTC_STATUS) & RTC_NEW_CLOCK)? RTC_CNTR3 : RTC_SEC;
+	val = rtc_read (addr);
+	while (val == rtc_read (addr))
+		delay (1000);
+	return (0);
+}
