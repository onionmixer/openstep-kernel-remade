+	IOReturn      ret;
+	id	thePCIBus = getThePCIBus();
+
+	if (![self isPCIPresent]) return IO_R_NO_DEVICE;
+
+	ret = [descr getPCIdevice: &devNum function: &funNum bus: &busNum];
+	if (ret != IO_R_SUCCESS) return ret;
+
+	return [thePCIBus setRegister: address
