+/*
+ * Charge a profiling tick to the profiling buffer that covers pc
+ * (the first of the chained buffers that does).  A copyin failure
+ * turns off the first buffer's profiling (original 0x18ce65).
+ */
+addupc(pc, pr, ticks)
+	register int pc;
+	register struct uuprof *pr;
+{
+	register struct uuprof *p;
+	register short *cell;
+	short count;
+	long off;
+
+	for (p = pr; p; p = p->pr_next) {
+		off = (((pc - p->pr_off)&0xffff0000) >> 16)*p->pr_scale +
+			((((pc - p->pr_off)&0xffff)*p->pr_scale)>>16);
+		cell = p->pr_base + off / (sizeof *cell);
+		if (cell >= p->pr_base &&
+		    cell < (short*) (p->pr_size + (int) p->pr_base)) {
+			if (copyin (cell, (caddr_t) &count, sizeof(count))) {
+				pr->pr_scale = 0;
+			} else {
+				count += ticks;
+				copyout((caddr_t) &count, cell, sizeof(count));
+			}
+			return;
+		}
+	}
+}
+
+void
+halt_cpu(int howto)
+{
+	switch (glLanguage) {
+	case 0:			/* English */
+	default:
+		prettyPrint("It's safe to turn off the computer.\n");
+		break;
+	case 1:			/* French */
+		prettyPrint("Vous pouvez maintenant eteindre\n"
+			    "votre ordinateur en toute securite.\n");
+		break;
+	case 2:			/* German */
+		prettyPrint("Jetzt koennen Sie Ihren Computer\n"
+			    "sicher ausschalten.\n");
+		break;
+	case 3:			/* Spanish */
+		prettyPrint("Ahora es seguro apagar el ordenador.\n");
+		break;
+	case 4:			/* Italian */
+		prettyPrint("Ora puoi spegnere il computer.\n");
+		break;
+	case 5:			/* Swedish */
+		prettyPrint("Nu ar det sakert att stanga av datorn.\n");
+		break;
+	}
+	kmDisableAnimation();
+	led_msg("Hltd");
+	(void) intr_disbl();
+	machine_slot[cpu_number()].running = FALSE;
+	if (howto & RB_POWERDOWN)
+		PMSetPowerState(PM_SYSTEM_DEVICE, PM_OFF);
+	for (;;)
+		asm volatile("hlt");
+}
+
+static void
+prettyPrint(char *str)
+{
+	printf(str);
+	if (prettyShutdown)
+		kmGraphicPanelString(str);
+}
+
+void
+md_prepare_for_shutdown(paniced, howto, command)
+	int	paniced, howto;
+	char	*command;
+{
+	if (howto & RB_HALT)
+		prettyPrint(kmLocalizeString("Please wait until it's safe\n"
+					     "to turn off the computer.\n"));
+}
+
+void
+md_shutdown_devices(paniced, howto, command)
+	int	paniced, howto;
+	char	*command;
+{
+	_io_setDriverPowerState(PM_OFF);
+}
+
+/* OR val into CMOS byte 6 (read by the booter) */
+static void
+valToCMOS(int val)
+{
+	int	oldval;
+
+	outb(0x70, 6);
+	oldval = inb(0x71);
+	val |= oldval;
+	outb(0x70, 6);
+	outb(0x71, val);
+}
+
+void
+md_do_shutdown(paniced, howto, command)
+	int	paniced, howto;
+	char	*command;
+{
+	rebootflag = 1;
+	if (howto & RB_HALT)
+		halt_cpu(howto);
+	if (paniced == RB_PANIC)
+		halt_cpu(howto);
+	if (howto & RB_BOOTNEXT)
+		valToCMOS(0x10);
+	else if (howto & RB_BOOTDOS)
+		valToCMOS(0x20);
+	(void) intr_disbl();
+	keyboard_reboot();
+	for (;;)
+		asm volatile("hlt");
+}
