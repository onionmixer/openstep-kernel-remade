+/*
+ * Spin for us units of us_spin_us_const iterations (plan 241.1:
+ * unsigned counts tested with > 0, variant s5p226-v3 x1).
+ */
+void
+us_spin(unsigned int us)
+{
+	unsigned int	i;
+
+	while (us-- > 0) {
+		i = us_spin_us_const;
+		while (i-- > 0)
+			;
+	}
+}
