+/*
+ * plan 205 (authored, D024; original _sleep 0x10a588,
+ * _sleep_with_continuation 0x10a708 and
+ * _sleep_with_continuation_and_deadline 0x10a898): one body, inlined into
+ * the three entry points (name of the helper not recovered).
+ */
+static inline int
+sleep_common(chan, pri, continuation, deadline)
+	caddr_t chan;
+	int pri;
+	void (*continuation)();
+	struct timeval *deadline;
+{
+	register struct proc *rp;
+	register s;
+
+	rp = u.u_procp;
+	s = splhigh();
+	/* allow to continue after panics so we can try to shut down. */
+	if (rp)
+		rp->p_pri = pri & PMASK;
+	assert_wait((int) chan, pri > PZERO);
+	if (pri > PZERO) {
+		/*
+		 * If wakeup occurs while in issig, thread_block()
+		 * below is a no-op.  If ISSIG finds a signal, clear
+		 * sleep condition before going to process it.
+		 */
+		if (rp && ISSIG_CATCH(rp)) {
+			clear_wait(current_thread(), THREAD_INTERRUPTED,
+					TRUE);
+			(void) spl0();
+			goto psig;
+		}
+		if (deadline)
+			thread_set_timeout(hzto(deadline));
+		(void) spl0();
+		u.u_ru.ru_nvcsw++;
+		if (cpu_number() != master_cpu) {
+			printf("unix sleep: on slave?\n");
+		}
+		thread_block_with_continuation(continuation);
+		if (rp && ISSIG_CATCH(rp))
+			goto psig;
+	} else {
+		if (deadline)
+			thread_set_timeout(hzto(deadline));
+		(void) spl0();
+		u.u_ru.ru_nvcsw++;
+		if (cpu_number() != master_cpu) {
+			printf("unix sleep: on slave?\n");
+		}
+		thread_block_with_continuation(continuation);
+	}
+	spln(s);
+	return(0);
+
+psig:
+	if (continuation)
+		call_continuation(continuation);
+	if (pri & PCATCH)
+		return(1);
+	longjmp(&u.u_qsave);
+	/*NOTREACHED*/
+}
+
+int sleep(chan, pri)
+	caddr_t chan;
+	int pri;
+{
+	return (sleep_common(chan, pri, (void (*)())0, (struct timeval *)0));
+}
+
+int sleep_with_continuation(chan, pri, continuation)
+	caddr_t chan;
+	int pri;
+	void (*continuation)();
+{
+	return (sleep_common(chan, pri, continuation, (struct timeval *)0));
+}
+
+int sleep_with_continuation_and_deadline(chan, pri, continuation, deadline)
+	caddr_t chan;
+	int pri;
+	void (*continuation)();
+	struct timeval *deadline;
+{
+	return (sleep_common(chan, pri, continuation, deadline));
+}
+#else	NeXT
