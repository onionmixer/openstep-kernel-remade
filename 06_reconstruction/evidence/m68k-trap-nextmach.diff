+    struct proc			*p = u.u_procp;
+    int				*ar0;
+    struct regs			*saved_regs;
+    int				result;
+    int				_exception, code, subcode;
+
+    if (p) {
+	ar0 = u.u_ar0;
+	u.u_ar0 = (int *)regs;
+    }
+    saved_regs = thread->pcb->saved_regs;
+    thread->pcb->saved_regs = regs;
+
+    while (result = _move_space(addr, fc, size, data, &_exception, &code, &subcode)) {
+	if (fc & ~3)
