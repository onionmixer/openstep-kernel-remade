+	if (thread_should_halt(current_thread()) || pc != regs->r_pc ||
+		(p && CHECK_SIGNALS(p, thread, thread->_uthread)))
+	    break;
+    }
+
+    thread->pcb->saved_regs = saved_regs;
+    if (p)
+	u.u_ar0 = ar0;
+
+    return (result);
+}
