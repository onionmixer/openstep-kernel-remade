+	if ((deltat < 2*SECDAY) && (boottime.tv_sec > base))
+		return;
+	if (boottime.tv_sec < SECYR) {
+		printf ("WARNING: clock not set properly");
+		now.tv_sec = base;
+		now.tv_usec = 0;
+		setthetime(&now);
+		boottime = now;
+		goto check;
+	}
