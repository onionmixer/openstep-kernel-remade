+		printf ("WARNING: preposterous time in Real Time Clock");
+		now.tv_sec = base;
+		now.tv_usec = 0;
+		setthetime(&now);
+		boottime = now;
+		goto check;
+	}
+	printf("WARNING: clock lost %d days", deltat / SECDAY);
+check:
+	printf(" -- CHECK AND RESET THE DATE!\n");
