+/*
+ * Advisory record locking on a vnode (called from the file system
+ * lockctl operations).
+ */
+int
+lf_lockctl(vp, fl, cmd)
+	struct vnode *vp;
+	register struct flock *fl;
+	int cmd;
+{
+	register struct lockf *lock;
+	register struct lf_svnode *svp;
+	int error;
+
+	svp = lf_get_svnode(vp);
+	lock = (struct lockf *)kalloc(sizeof (struct lockf));
+	lock->lf_type = fl->l_type;
+	lock->lf_start = fl->l_start;
+	lock->lf_end = fl->l_len ? fl->l_start + fl->l_len - 1 : -1;
+	lock->lf_posix_procp = get_posix_proc(u.u_procp->p_pid);
+	lock->lf_svnodep = svp;
+	svp->lf_refcnt++;
+	lock->lf_next = NOLOCKF;
+	lock->lf_block = NOLOCKF;
+
+	if (cmd == F_GETLK) {
+		error = lf_getlock(lock, fl);
+		lf_free(lock);
+	} else if (fl->l_type == F_UNLCK) {
+		error = lf_clearlock(lock);
+		lf_free(lock);
+	} else {
+		if (cmd == F_SETLK)
+			lock->lf_flags = LF_NOWAIT;
+		else
+			lock->lf_flags = LF_WAIT;
+		return (lf_setlock(lock));
+	}
+	lf_free_svnode(svp);
+	return (error);
+}
+
+/*
+ * Find (or make) the shadow vnode of vp and move it to the front of
+ * its hash chain.
+ */
+static struct lf_svnode *
+lf_get_svnode(vp)
+	register struct vnode *vp;
+{
+	register struct lf_svnode **hp, **svpp, *svp;
+
+	hp = &lf_svnode_hash[LF_SVNODE_HASH((int)vp)];
+	for (svpp = hp; *svpp; svpp = &svp->lf_next) {
+		svp = *svpp;
+		if (svp->lf_vnodep == vp) {
+			if (svpp == hp)
+				goto out;
+			*svpp = svp->lf_next;	/* move it to the front */
+			goto link;
+		}
+	}
+	svp = (struct lf_svnode *)kalloc(sizeof (struct lf_svnode));
+	svp->lf_vnodep = vp;
+	svp->lf_lockfp = NOLOCKF;
+	svp->lf_refcnt = 0;
+	vp->v_count++;
+link:
+	svp->lf_next = *hp;
+	*hp = svp;
+out:
+	return (*hp);
+}
+
+/*
+ * Free a shadow vnode that no lock refers to any more.
+ */
+static void
+lf_free_svnode(svp)
+	register struct lf_svnode *svp;
+{
+	register struct lf_svnode **svpp, *p;
+
+	if (svp->lf_refcnt > 0)
+		return;
+	for (svpp = &lf_svnode_hash[LF_SVNODE_HASH((int)svp->lf_vnodep)];
+	    *svpp; svpp = &p->lf_next) {
+		p = *svpp;
+		if (p == svp) {
+			vn_rele(p->lf_vnodep);
+			*svpp = p->lf_next;
+			kfree((vm_offset_t)p, sizeof (struct lf_svnode));
+			return;
+		}
+	}
+	panic("lf_free_svnode: cannot find shadow vnode in hash list");
+}
