 /*
+ * plan 373 (D035): the fields of the boot loader's parameter block at
+ * physical 0x11000 that pmap_bootstrap uses (no i386 kernBootStruct.h in
+ * any reference tree).  The offsets are the original's (0x18f16c-0x18f1b4);
+ * the names are ours.
+ */
+typedef struct {
+	char		_reserved0[0x1854];
+	vm_offset_t	vbeFrameBuffer;		/* +0x1854: kernel address of the frame buffer */
+	char		_reserved1[0x185c - 0x1858];
+	unsigned short	vbeWidth;		/* +0x185c: 0 when no VESA mode is set */
+	unsigned short	vbeHeight;		/* +0x185e */
+	unsigned short	vbeRowBytes;		/* +0x1860 */
+	char		_reserved2[0x186c - 0x1862];
+	vm_offset_t	vbePhysBase;		/* +0x186c: physical address of the frame buffer */
+} KERNBOOTSTRUCT;
+#define	KERNSTRUCT_ADDR	((KERNBOOTSTRUCT *) 0x11000)
+
+/*
  */
 void
 pmap_bootstrap(
@@ -408,10 +426,24 @@
