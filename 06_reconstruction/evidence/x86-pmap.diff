-		   64*1024*1024	+	/* base size */
-		   zone_map_sizer() +	/* zone allocator */
-		   buffer_map_sizer(),	/* buffer cache */
+		   64*1024*1024,	/* base size; plan 373: no zone/buffer sizers */
 		   VM_PROT_NONE);
+
+    /*
+     * plan 373: map the VESA frame buffer the boot loader set up and
+     * leave its kernel address in the parameter block (written from
+     * the original bytes 0x18f16c-0x18f29a, D024).
+     */
+    if (KERNSTRUCT_ADDR->vbeWidth) {
+	vm_offset_t	phys = KERNSTRUCT_ADDR->vbePhysBase;
+	vm_size_t	size = KERNSTRUCT_ADDR->vbeRowBytes *
+				KERNSTRUCT_ADDR->vbeHeight;
+	vm_offset_t	start = trunc_page(phys);
+	vm_offset_t	end = round_page(size + 2 * phys - start);
+
+	KERNSTRUCT_ADDR->vbeFrameBuffer = va + phys - start;
+	va = pmap_map(va, start, end, VM_PROT_READ | VM_PROT_WRITE);
+    }
 		   
     *virt_end = va;
 
