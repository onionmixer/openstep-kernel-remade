+/*
+ * plan 221 (authored, D024; original _gc_init 0x17c40c, _gc_control
+ * 0x17c428): flush the kernel caches and collect the zones on request
+ * of the super-user.
+ */
+decl_simple_lock_data(,	gc_lock)
+boolean_t	gc_active;
+
+gc_init()
+{
+	simple_lock_init(&gc_lock);
+	gc_active = FALSE;
+}
+
+gc_control()
+{
+	register struct a {
+		int	flags;
+	} *uap = (struct a *)u.u_ap;
+
+	if (!suser())
+		return;
+	simple_lock(&gc_lock);
+	if (!gc_active) {
+		gc_active = TRUE;
+		simple_unlock(&gc_lock);
+		if (uap->flags & 1) {
+			mfs_cache_clear();
+			vm_object_cache_clear();
+			inode_cache_clear();
+			rnode_cache_clear();
+			proc_cache_clear();
+		}
+		if (uap->flags & 2)
+			zone_gc();
+		if (uap->flags & 4)
+			zone_reclaim();
+		simple_lock(&gc_lock);
+		gc_active = FALSE;
+	}
+	simple_unlock(&gc_lock);
+}
