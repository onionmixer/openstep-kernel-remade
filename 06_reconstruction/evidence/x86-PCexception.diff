--- /dev/null	2026-09-16 12:58:03.398972062 +0900
+++ 07_kernel/src/machdep/i386/pc_support/PCexception.c	2026-10-03 22:34:36.819188039 +0900
@@ -0,0 +1,103 @@
+/*
+ * PC support exception handling (plan 252).
+ *
+ * Written for this project from the OPENSTEP 4.2 kernel bytes (D024).
+ * Darwin 0.1 machdep/i386/pc_support/PCexception.c was consulted for
+ * structure only; the original kernel also saves and clears the BSD
+ * u_error around the page fault.  The control flow is fixed by the
+ * bytes, so the text may resemble Darwin's (D027).
+ */
+
+#import <mach/mach_types.h>
+#import <mach/exception.h>
+
+#import <machdep/i386/trap.h>
+#import <machdep/i386/cpu_inline.h>
+#import <machdep/i386/err_inline.h>
+
+#import <sys/user.h>
+
+#import "PCprivate.h"
+
+static void	PCfaultContinue(void);
+
+boolean_t
+PCexception(
+    thread_t			thread,
+    thread_saved_state_t	*state
+)
+{
+    PCcontext_t		context = threadPCContext(thread);
+
+    if (!context->running)
+	return (FALSE);
+
+    if (state->trapno == T_PAGE_FAULT) {
+	kern_return_t	result;
+	vm_offset_t	va;
+	int		error;
+
+	/* plan 252: vm_fault must not see a pending BSD error */
+	error = u.u_error;
+	u.u_error = 0;
+	va = cr2();
+	result = vm_fault(thread->task->map, trunc_page(va),
+			    state->frame.err.pgfault.wrtflt ?
+				VM_PROT_READ | VM_PROT_WRITE :
+				VM_PROT_READ,
+			    FALSE, 0);
+	u.u_error = error;
+	if (result != KERN_SUCCESS) {
+	    context->trapNum = state->trapno;
+	    context->errCode = err_to_error_code(state->frame.err);
+	    context->exceptionResult = result;
+
+	    exception_with_continuation(
+			EXC_BAD_ACCESS, result, va, PCfaultContinue);
+
+	    if (context->exceptionResult != KERN_SUCCESS) {
+		context->callHandler = PC_HANDLE_FAULT;
+		PCcallMonitor(thread, state);
+	    }
+	}
+    }
+    else if (state->trapno == T_NOEXTENSION && !context->EM_bit)
+	fp_noextension(state);
+    else if (state->frame.eflags & EFL_VM) {
+	if (!PCemulateREAL(thread, state))
+	    return (FALSE);
+    }
+    else {
+	if (!PCemulatePROT(thread, state))
+	    return (FALSE);
+    }
+
+    if (context->callHandler == PC_HANDLE_NONE &&
+	    (context->pendingCallbacks || PCtimersPending(context)))
+	PCcallMonitor(thread, state);
+
+    thread_exception_return();
+}
+
+/*
+ * Continuation of the page fault exception message.
+ */
+static
+void
+PCfaultContinue(void)
+{
+    thread_t			thread = current_thread();
+    thread_saved_state_t	*state = USER_REGS(thread);
+    PCcontext_t			context = threadPCContext(thread);
+
+    if (context->exceptionResult != KERN_SUCCESS) {
+	context->callHandler = PC_HANDLE_FAULT;
+	PCcallMonitor(thread, state);
+    }
+
+    if (context->callHandler == PC_HANDLE_NONE &&
+	    (context->pendingCallbacks || PCtimersPending(context)))
+	PCcallMonitor(thread, state);
+
+    thread_exception_return();
+}
