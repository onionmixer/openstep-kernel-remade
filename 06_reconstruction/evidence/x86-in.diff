+/*
+ * plan 171 (authored, D024; original _in_addmulti 0x123fc0 and _in_delmulti
+ * 0x1240d4, MULTICAST 1.0 form): add or drop a membership in a multicast group.
+ */
+struct in_multi *
+in_addmulti(addr, ifp)
+	struct in_addr addr;
+	struct ifnet *ifp;
+{
+	register struct in_multi *inm;
+	struct in_ifaddr *ia;
+	struct mbuf *m;
+	struct ifreq ifr;
+	caddr_t ifrp;	/* plan 171.1 (variant v1) */
+	int s = splnet();
+
+	IN_LOOKUP_MULTI(addr, ifp, inm);
+	if (inm != NULL) {
+		++inm->inm_refcount;
+	} else {
+		IFP_TO_IA(ifp, ia);
+		if (ia == NULL ||
+		    (m = m_getclr(M_DONTWAIT, MT_IPMADDR)) == NULL) {
+			splx(s);
+			return (NULL);
+		}
+		inm = mtod(m, struct in_multi *);
+		inm->inm_addr = addr;
+		inm->inm_ifp = ifp;
+		inm->inm_refcount = 1;
+		inm->inm_ia = ia;	/* plan 171.1: after refcount (original store order) */
+		inm->inm_next = ia->ia_multiaddrs;
+		ia->ia_multiaddrs = inm;
+		ifrp = (caddr_t)&ifr;
+		((struct sockaddr_in *)&ifr.ifr_addr)->sin_family = AF_INET;
+		((struct sockaddr_in *)&ifr.ifr_addr)->sin_addr = addr;
+		if (ifp->if_control == NULL ||
+		    if_ioctl((netif_t)ifp, SIOCADDMULTI, (void *)ifrp) != 0) {
+			ia->ia_multiaddrs = inm->inm_next;
+			m_free(m);
+			inm = NULL;
+		} else
+			igmp_joingroup(inm);
+	}
+	splx(s);
+	return (inm);
+}
+
+in_delmulti(inm)
+	register struct in_multi *inm;
+{
+	register struct in_multi **p;
+	struct ifreq ifr;
+	int s = splnet();
+
+	if (--inm->inm_refcount == 0) {
+		igmp_leavegroup(inm);
+		for (p = &inm->inm_ia->ia_multiaddrs;
+		     *p != inm;
+		     p = &(*p)->inm_next)
+			continue;
+		*p = (*p)->inm_next;
+		((struct sockaddr_in *)&ifr.ifr_addr)->sin_family = AF_INET;
+		((struct sockaddr_in *)&ifr.ifr_addr)->sin_addr = inm->inm_addr;
+		if_ioctl((netif_t)inm->inm_ifp, SIOCDELMULTI, (void *)&ifr);
+		m_free(dtom(inm));
+	}
+	splx(s);
+}
