+	if (syscode < 0) { \
+		callp = &sysent[63]; /* XXX 172 -> 63 */ \
+	} \
+	else { \
+		callp = (syscode >= nsysent) ? &sysent[63] : \
+				&sysent[syscode]; \
+	}
