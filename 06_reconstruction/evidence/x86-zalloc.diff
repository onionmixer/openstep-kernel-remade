+			(vm_offset_t)cur = new_space + size;
+			cur->length = space_to_add - size;
+			if (cur->next = *last)
+				cur->next->pred = &cur->next;
+			cur->pred = last;
+			*last = cur;
+			freespace->num_entries++;
