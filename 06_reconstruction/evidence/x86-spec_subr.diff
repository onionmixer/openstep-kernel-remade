 /*
+ * plan 224 (authored, D024; original _set_blocksize 0x1395f0): record the
+ * block size the block device reports (d_psize) in the snode, and in the
+ * shared block-device snode if it has none yet.
+ */
+set_blocksize(sp, dev)
+	register struct snode *sp;
+	dev_t dev;
+{
+	int (*size)();
+	long rsize;
+
+	if ((major(dev) < nblkdev) &&
+	    (size = bdevsw[major(dev)].d_psize)) {
+		rsize = (*size)(dev);
+		if (rsize != -1) {
+			sp->s_size = rsize;
+			if (sp->s_bdevvp && VTOS(sp->s_bdevvp)->s_size == 0)
+				VTOS(sp->s_bdevvp)->s_size = rsize;
+			return;
+		}
+	}
+	sp->s_size = 0;
+}
