+/*
+ * plan 291 (authored, D024; original static function 0x105a3c): map a
+ * load_machfile result to an errno (Darwin 0.1 has the same function).
+ */
+static int
+load_return_to_errno(lrtn)
+	load_return_t	lrtn;
+{
+	switch (lrtn) {
+	case LOAD_SUCCESS:
+		return 0;
+	case LOAD_BADARCH:
+		return EBADARCH;
+	case LOAD_BADMACHO:
+		return EBADMACHO;
+	case LOAD_SHLIB:
+		return ESHLIBVERS;
+	case LOAD_NOSPACE:
+		return ENOMEM;
+	case LOAD_PROTECT:
+		return EACCES;
+	case LOAD_RESOURCE:
+	case LOAD_FAILURE:
+	default:
+		return EBADEXEC;
+	}
