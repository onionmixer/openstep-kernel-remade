+kern_return_t snd_reply_ret_formats (
+	port_name_t	remote_port,
+	u_int		rates,
+	u_int		low,
+	u_int		high,
+	u_int		encodings,
+	u_int		chans)
+{
+	snd_ret_stream_formats_t msg;
+
+	msg.header = snd_reply_header_template;
+	msg.header.msg_id = SND_MSG_RET_STREAM_FORMATS;
+	msg.header.msg_size = sizeof(snd_ret_stream_formats_t);
+	msg.header.msg_remote_port = remote_port;
+
+	msg.Type = snd_type_int_template;
+	msg.Type.msg_type_number = 5;
+	msg.rate = rates;
+	msg.low_rate = low;
+	msg.high_rate = high;
+	msg.encoding = encodings;
+	msg.chan_count = chans;
+
+	return msg_send((msg_header_t *)&msg, SEND_TIMEOUT, 0);
