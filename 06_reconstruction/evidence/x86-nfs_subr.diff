+static void	rlock_awaken();
 
+int
+rlock_timeout(rp, secs)
+	register struct rnode *rp;
+	int secs;
+{
+	int s;
+
+	while ((rp->r_flags & RLOCKED) && rp->r_thread != current_thread()) {
+		if (rp->r_flags & RTIMEDOUT) {
+			rlockretimeout++;
+			return (1);
