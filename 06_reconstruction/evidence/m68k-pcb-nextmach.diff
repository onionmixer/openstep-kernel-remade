+)
+{
+    struct m68k_thread_state_regs	*state;
+
+    switch (flavor) {
+
+    case M68K_THREAD_STATE_REGS:
+	if (count < M68K_THREAD_STATE_REGS_COUNT)
+	    return (KERN_INVALID_ARGUMENT);
+
+	state = (struct m68k_thread_state_regs *) tstate;
+
+	*entry_point = state->pc;
