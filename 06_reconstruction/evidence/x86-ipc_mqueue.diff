 /*
+ *	Routine:	ipc_mqueue_send_interrupt
+ *	Purpose:
+ *		plan 266: written from the original bytes (D024).
+ *		Deliver a message without blocking (no message-format
+ *		check in the original): give up
+ *		with MACH_MSG_IPC_KERNEL if the port or message queue
+ *		lock is busy, and with MACH_SEND_INVALID_DEST if the
+ *		port is dead.  (Darwin 0.1 ipc/ipc_mqueue.c has a
+ *		routine of this name; consulted for structure only, D027.)
+ */
+
+mach_msg_return_t
+ipc_mqueue_send_interrupt(kmsg)
+	ipc_kmsg_t kmsg;
+{
+	ipc_port_t port;
+	ipc_mqueue_t mqueue;
+	ipc_pset_t pset;
+	ipc_thread_t receiver;
+	ipc_thread_queue_t receivers;
+
+	port = (ipc_port_t) kmsg->ikm_header.msgh_remote_port;
+
+	if (!ip_lock_try(port))
+		return MACH_MSG_IPC_KERNEL;
+
+	if (!ip_active(port)) {
+		ip_unlock(port);
+		return MACH_SEND_INVALID_DEST;
+	}
+
+	pset = port->ip_pset;
+	if (pset == IPS_NULL)
+		mqueue = &port->ip_messages;
+	else
+		mqueue = &pset->ips_messages;
+
+	if (!imq_lock_try(mqueue)) {
+		ip_unlock(port);
+		return MACH_MSG_IPC_KERNEL;
+	}
+	receivers = &mqueue->imq_threads;
+
+	port->ip_msgcount++;
+	ip_unlock(port);
+
+	for (;;) {
+		receiver = ipc_thread_queue_first(receivers);
+		if (receiver == ITH_NULL) {
+			ipc_kmsg_enqueue_macro(&mqueue->imq_messages, kmsg);
+			imq_unlock(mqueue);
+			break;
+		}
+
+		ipc_thread_rmqueue_first_macro(receivers, receiver);
+
+		if (kmsg->ikm_header.msgh_size <= receiver->ith_msize) {
+			receiver->ith_state = MACH_MSG_SUCCESS;
+			receiver->ith_kmsg = kmsg;
+			receiver->ith_seqno = port->ip_seqno++;
+			imq_unlock(mqueue);
+
+			thread_go(receiver);
+			break;
+		}
+
+		receiver->ith_state = MACH_RCV_TOO_LARGE;
+		receiver->ith_msize = kmsg->ikm_header.msgh_size;
+		thread_go(receiver);
+	}
+
+	return MACH_MSG_SUCCESS;
+}
