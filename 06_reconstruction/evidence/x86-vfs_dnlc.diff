 /*
+ * plan 184 (authored, D024): the queue operations are done in line in the
+ * original (no insque/remque/insque2/remque2 calls, 0x11b28c-0x11b984);
+ * they are static functions defined before use so that -O3 inlines them.
+ */
+static struct ncache *dnlc_search();
+static dnlc_rm();
+
+/*
+ * Insert into queue, where the queue pointers are
+ * in the second two longwords.
+ */
+static
+insque2(ncp2, ncp1)
+	register struct ncache *ncp2, *ncp1;
+{
+	register struct ncache *ncp3;
+
+	ncp3 = ncp1->lru_next;
+	ncp1->lru_next = ncp2;
+	ncp2->lru_next = ncp3;
+	ncp3->lru_prev = ncp2;
+	ncp2->lru_prev = ncp1;
+}
+
+/*
+ * Remove from queue, like insque2.
+ */
+static
+remque2(ncp)
+	register struct ncache *ncp;
+{
+	ncp->lru_prev->lru_next = ncp->lru_next;
+	ncp->lru_next->lru_prev = ncp->lru_prev;
+}
+
+/*
+ * The same for the hash chains (first two longwords).
+ */
+static
+nc_insque(e, p)
+	register struct ncache *e, *p;
+{
+	e->hash_next = p->hash_next;
+	e->hash_prev = p;
+	p->hash_next->hash_prev = e;
+	p->hash_next = e;
+}
+
+static
+nc_remque(e)
+	register struct ncache *e;
+{
+	e->hash_next->hash_prev = e->hash_prev;
+	e->hash_prev->hash_next = e->hash_next;
+}
+
+#define	INS_LRU(ncp1,ncp2)	insque2((struct ncache *) ncp1, (struct ncache *) ncp2)
+#define	RM_LRU(ncp)		remque2((struct ncache *) ncp)
+#undef	INS_HASH
+#undef	RM_HASH
+#define	INS_HASH(ncp,nch)	nc_insque((struct ncache *) ncp, (struct ncache *) nch)
+#define	RM_HASH(ncp)		nc_remque((struct ncache *) ncp)
+
