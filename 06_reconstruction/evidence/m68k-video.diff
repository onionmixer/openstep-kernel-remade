+/* plan 761 (D024, D171) BEGIN: vid_ev_show */
+ static int
+vid_ev_show(EvScreen *es, Point loc, int frame)
+{
+    vid_flush_flags = 0;
+    if (msp->cursorSema)
+	return 1;
+    msp->cursorSema = 1;
+    msp->frame = frame;
+    msp->cursorLoc = loc;
+    VID_SHIELD();
+    VID_SHOW();
+    msp->cursorSema = 0;
+    VID_CACHE_FLUSH();
+    return 0;
+}
