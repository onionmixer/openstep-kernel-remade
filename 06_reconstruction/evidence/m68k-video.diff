+/* plan 761 (D024, D171) BEGIN: vidApplyBrightness */
+ static void
+vidApplyBrightness()
+{
+	int level;
+	struct nvram_info ni;
+
+	if ( evOpenCalled ) {
+		if ( autoDimmed && dimmedBrightness < curBright )
+			level = dimmedBrightness;
+		else
+			level = curBright;
+	} else {
+		nvram_check(&ni);
+		level = ni.ni_brightness;
+	}
+	vidSetBrightness( level );
+}
