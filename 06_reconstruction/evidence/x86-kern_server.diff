+/*
+ * plan 352 (authored, D024; original 0x16c96c): remember the server's
+ * mach header and register its Objective-C module.
+ */
+kern_return_t kern_serv_load_objc(
+	void		*arg,
+	vm_address_t	header)
+{
+	kern_server_t ksp = *((kern_server_t *)arg);
+	int		error;
+
+#if	KERNOBJC
+	ksp->mach_header = (struct mach_header *) header;
+	error = objc_registerModule (ksp->mach_header, 0);
+#endif	KERNOBJC
+	return KERN_SUCCESS;
+}
