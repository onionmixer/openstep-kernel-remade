+		vattr.va_atime.tv_sec = times[0];
+		vattr.va_mtime.tv_sec = times[1];
+		vattr.va_atime.tv_usec = vattr.va_mtime.tv_usec = 0;
+	}
+	error = namesetattr(uap->fname, FOLLOW_LINK, &vattr);
