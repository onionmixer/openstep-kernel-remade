+/* plan 576 (D130, D024): new in 1997; written from the original bytes 0x406ba5a */
+int fdsize(dev_t dev)
+{
+	int volume = FD_VOLUME(dev);
+	fd_volume_t fvp = fd_volume_p[volume];
+
+	if(volume == FVP_CONTROLLER)
+		return(0);
+	if((volume > FVP_CONTROLLER) || (fvp == NULL))
+		return(-1);
+	if(fvp->format_info.flags & FFI_LABELVALID)
+		return(fvp->labelp->dl_secsize);
+	else
+		return(fvp->format_info.sectsize_info.sect_size);
+}
