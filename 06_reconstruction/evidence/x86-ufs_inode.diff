+/*
+ * plan 215 (authored, D024; original _inode_cache_clear 0x140664):
+ * release the free inodes back to their zones.
+ */
+inode_cache_clear()		/* plan 215.1: variant g1 (s5p191-v1, v2) */
+{
+	register struct inode *ip, *iq, *prev;
+
+	while ((ip = ifreeh) != NULL) {
+		if (iq = ip->i_freef)
+			iq->i_freeb = &ifreeh;
+		ifreeh = iq;
+		ip->i_freef = NULL;
+		ip->i_freeb = NULL;
+		mfs_uncache(ITOV(ip));
+		ip->i_flag = IRELEASE_TO_ZONE;
+		ILOCK(ip);
+		if (ITOV(ip)->v_count != 0)
+			panic("free inode isn't");
+		remque(ip);
+	}
+	prev = ip = inode_list;
+	while (ip != NULL) {
+		if (ip->i_flag & IRELEASE_TO_ZONE) {
+			if (prev == ip)
+				prev = inode_list = ip->inode_list;
+			else
+				prev->inode_list = ip->inode_list;
+			iq = ip->inode_list;
+			zfree(vm_info_zone, ip->i_vnode.vm_info);
+			zfree(inode_zone, ip);
+		} else {
+			iq = ip->inode_list;
+			prev = ip;
+		}
+		ip = iq;
+	}
+}
