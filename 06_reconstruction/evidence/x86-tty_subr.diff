 /*
+ * plan 183 (authored, D024; original _nextc3 0x113390): like nextc, but
+ * also return the character (with TTY_QUOTE) through c.
+ */
+char *
+nextc3(p, cp, c)
+	register struct clist *p;
+	register char *cp;
+	register int *c;
+{
+
+	if (p->c_cc && ++cp != p->c_cl) {
+		if (((int)cp & CROUND) == 0)
+			cp = ((struct cblock *)cp)[-1].c_next->c_info;
+		*c = *cp;
+		if (isset(((struct cblock *)((int)cp & ~CROUND))->c_quote, (int)cp & CROUND))
+			*c |= TTY_QUOTE;
+		return (cp);
+	}
+	return (0);
+}
