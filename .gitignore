/01_resources/upstream/*
!/01_resources/upstream/.gitkeep
/01_resources/archives/*
!/01_resources/archives/.gitkeep
/03_original/**/binaries/*
!/03_original/**/binaries/.gitkeep
/04_ghidra/projects/*
!/04_ghidra/projects/.gitkeep
/05_ida/databases/*
!/05_ida/databases/.gitkeep
/05_ida/snapshots/*
!/05_ida/snapshots/.gitkeep
/08_build/artifacts/*
!/08_build/artifacts/.gitkeep
/08_build/toolchains/*
!/08_build/toolchains/.gitkeep
/09_validation/images/*
!/09_validation/images/.gitkeep
__pycache__/
*.pyc
*.part
a.txt

# Internal handoff notes: not part of the public tree.
HANDOFF.md
# Local working standard for the m68k/SPARC reconstruction: not public.
/02_plan/MULTIARCH_RECONSTRUCTION_STANDARD.md

# Hex-Rays IDA SDK is not redistributable; only its pinned commit and hash
# stay in 10_tools/vendor-cache/README.md.
/10_tools/vendor-cache/ida-sdk-*.bundle

# Case dumps over GitHub's 100 MiB blob limit. Each one is committed as the
# gzip'd sibling (<name>.json.gz); the plain file stays on disk only.
/09_validation/reports/continuous-review-20260912-34/gc-cases.json
/09_validation/reports/continuous-review-20260911-32/fault-new-pt-cases.json
/09_validation/reports/continuous-review-20260912-36/direct-cases.json
/09_validation/reports/continuous-review-20260911-33/dirty-remove-cases.json
/09_validation/reports/continuous-review-20260912-40/removal-cases.json
/09_validation/reports/continuous-review-20260912-41/pd-cases.json

# Live kernel memory snapshots from the target: original kernel bytes plus
# runtime state.  The full comparison reports carry live values, including
# the site's network state (ARP table, PCBs), so they stay local too; the
# committed record is the value-free *-summary.json.
/09_validation/runtime/x86-live/*/*.bin
/09_validation/runtime/x86-live/*/context.txt
/09_validation/runtime/x86-live/*-compare.json
/09_validation/runtime/x86-live/*-full.json
/10_tools/runtime/bin/

# Emulator platform (02_plan/EMULATION_PLATFORM_PLAN.md): external git
# repositories, builds, firmware and private records stay out of this public
# repository.  Only the description, manifest and scripts are tracked.
/11_emulation/*
!/11_emulation/README.md
!/11_emulation/MANIFEST.json
!/11_emulation/QEMU_VM_CONFIGURATIONS.md
!/11_emulation/SPARC_INSTALL_HANG_NOTES.md
!/11_emulation/scripts/
# Records imported from openstep-iso-remade: private, large (install disks,
# ROMs, decompiled userland), not redistributable.  Only the README is tracked.
/12_archive/*
!/12_archive/README.md
/08_build/runs/*
!/08_build/runs/.gitkeep

# OPENSTEP 4.2 SDK header copies taken read-only from the real machine
# (/NextDeveloper/Headers, D018) and the SDK-text overlays built on them
# (D023).  Their license is still to be decided (D017), so they stay local;
# provenance is recorded in 07_kernel/PROVENANCE.tsv.
/07_kernel/nextdev/
/07_kernel/nextdev_private/
